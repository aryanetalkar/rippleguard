# RippleGuard Environment Configuration Template
# Copy this file to .env and populate with appropriate values.
# NEVER commit .env with real credentials into source control.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rippleguard

# External Vulnerability Intelligence (Future Phases)
OSV_API_URL=https://api.osv.dev/v1

# AI Intelligence Layer (Phase 6 Gemini Explanation)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Application Server & Security
CORS_ORIGIN=http://localhost:3000
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
